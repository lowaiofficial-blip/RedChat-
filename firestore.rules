rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 🔐 GÜVENLİK YARDIMCI FONKSİYONLARI (HELPER FUNCTIONS)
    // =========================================================================
    
    // Geçerli oturum açmış kullanıcı kontrolü
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Doküman sahibi kontrolü
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Sistem Yöneticisi kontrolü
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'robloxenes930@gmail.com' ||
          request.auth.token.email == 'gg00cat73@gmail.com'
        )) ||
        (request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // =========================================================================
    // ⚙️ UYGULAMA GENEL AYARLARI (/settings/{settingId})
    // =========================================================================
    // Mavi tik rozet görseli, yapay zeka profil resmi ve sistem ayarları
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 👤 KULLANICI PROFİLLERİ (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Tüm kullanıcılar ve misafirler profil arama ve önizleme yapabilir
      allow read: if true;
      
      // Kullanıcı kendi profilini veya admin yeni profil oluşturabilir
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Kullanıcı kendi profil bilgilerini (durum, bio, avatar, son görülme),
      // veya admin tüm kullanıcı alanlarını (doğrulama, ban vb.) güncelleyebilir
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Hesap silme işlemi
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // 🪪 PUSH NOTIFICATION TOKENLARI (fcmTokens)
      match /fcmTokens/{tokenId} {
        // Yalnızca kullanıcı kendi tokenlarını okuyup yazabilir
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // 📖 KULLANICI BELLEĞİ (MEMORIES)
      match /memories/{memoryId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // 🗂️ KULLANICININ TAKİP ETTİĞİ KANALLAR
      match /followingChannels/{channelId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // 🗂️ KULLANICININ OLUŞTURDUĞU KANALLAR
      match /myChannels/{channelId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }
    
    // =========================================================================
    // 🏷️ BENZERSİZ KULLANICI ADI REZERVASYONU (/usernames/{usernameLower})
    // =========================================================================
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 💬 SOHBETLER & GRUPLAR (/conversations/{conversationId})
    // =========================================================================
    match /conversations/{conversationId} {
      // Sohbet listesini dinleme (where participantIds contains) ve doğrudan sohbet getDoc sorgusu
      allow read: if isAuthenticated();
      
      // Yeni birebir sohbet, grup sohbeti veya RedChat AI sohbeti başlatma
      allow create: if isAuthenticated();
      
      // Son mesaj metni, son mesaj zamanı, okunmamış sayaçları (unreadCounts), grup üyeleri güncelleme
      allow update: if isAuthenticated();
      
      // Grubu silme veya sohbetten ayrılma
      allow delete: if isAuthenticated();
      
      // =======================================================================
      // 📨 SOHBET İÇİ MESAJLAR (/conversations/{conversationId}/messages/{messageId})
      // =======================================================================
      match /messages/{messageId} {
        // Sohbetteki tüm mesajları gerçek zamanlı dinleme ve okuma
        allow read: if isAuthenticated();
        
        // Yeni mesaj gönderme:
        // - Normal kullanıcı mesajları
        // - Sistem mesajları (gruba katıldı, ayrıldı, grup adı değişti vb.)
        // - RedChat AI tarafından üretilen yanıtlar (senderId: system_redchat_ai)
        allow create: if isAuthenticated();
        
        // Mesaj düzenleme (isEdited: true) ve emoji reaksiyonları ekleme/kaldırma
        allow update: if isAuthenticated();
        
        // Mesaj silme işlemi (benden sil / herkesten sil)
        allow delete: if isAuthenticated();
      }
    }

    // =========================================================================
    // 🔍 COLLECTION GROUP MESAJ ERİŞİMİ
    // =========================================================================
    // Global mesaj sayacı, admin istatistikleri ve arama filtreleri
    match /{path=**}/messages/{messageId} {
      allow read: if isAuthenticated();
    }

    // =========================================================================
    // 📢 KANALLAR SİSTEMİ (/channels/{channelId})
    // =========================================================================
    
    // Kanal kurucu kontrolü yardımcısı (kurucu bilgisini gizli dokümandan okur)
    function isChannelOwner(channelId) {
      return isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/channels/$(channelId)/private/owner) &&
          get(/databases/$(database)/documents/channels/$(channelId)/private/owner).data.ownerId == request.auth.uid
        )
      );
    }

    match /channels/{channelId} {
      // Kanalları tüm oturum açmış kullanıcılar listeleyebilir ve okuyabilir
      allow read: if isAuthenticated();

      // Kanal oluşturma
      allow create: if isAuthenticated();

      // Güncelleme: Kurucu veya Admin her şeyi güncelleyebilir; normal kullanıcılar takipçi sayısını artırıp azaltabilir
      allow update: if isAuthenticated();

      // Kanalı silme işlemi
      allow delete: if isAuthenticated();

      // 🔐 KURUCU GİZLİLİĞİ DOKÜMANI (/channels/{channelId}/private/owner)
      match /private/owner {
        allow read, write: if isAuthenticated();
      }

      // 👥 TAKİPÇİLER (/channels/{channelId}/followers/{followerUid})
      match /followers/{followerUid} {
        allow read, write: if isAuthenticated();
      }

      // 📝 GÖNDERİLER (/channels/{channelId}/posts/{postId})
      match /posts/{postId} {
        allow read, write: if isAuthenticated();

        // 👁️ BENZERSİZ GÖRÜNTÜLENME KAYITLARI (/channels/{channelId}/posts/{postId}/views/{viewerUid})
        match /views/{viewerUid} {
          allow read, write: if isAuthenticated();
        }
      }
    }
  }
}
