rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 🔐 GÜVENLİK YARDIMCI FONKSİYONLARI (HELPER FUNCTIONS)
    // =========================================================================
    
    // Geçerli oturum açmış kullanıcı kontrolü
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Doküman sahibi kontrolü
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Sistem Yöneticisi kontrolü
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'robloxenes930@gmail.com' ||
          request.auth.token.email == 'gg00cat73@gmail.com'
        )) ||
        (request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Kullanıcı Susturuldu mu? (Muted)
    function isUserMuted() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isMuted', false) == true;
    }

    // Kullanıcı E-Posta İncelemesinde mi?
    function isEmailInReview() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isEmailInReview', false) == true;
    }


    // =========================================================================
    // 🛡️ DOĞRULAMA BAŞVURULARI (/verificationRequests/{requestId})
    // =========================================================================
    match /verificationRequests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 🔐 ŞİFRE SIFIRLAMA TALEPLERİ (/passwordResetRequests/{requestId})
    // =========================================================================
    match /passwordResetRequests/{requestId} {
      // Adminler tüm talepleri okuyup yönetebilir, kullanıcılar talep oluşturabilir
      allow read, write: if true;
    }

    // =========================================================================
    // 🚫 DONANIM VE IP BANLARI (/banned_devices/{banId})
    // =========================================================================
    // Oturum açmamış cihazlar dahi ban durumunu sorgulayabilmelidir (allow read: if true)
    match /banned_devices/{banId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // ⚙️ UYGULAMA GENEL AYARLARI (/settings/{settingId})
    // =========================================================================
    // Mavi tik rozet görseli, yapay zeka profil resmi ve sistem ayarları
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 👤 KULLANICI PROFİLLERİ (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Tüm kullanıcılar ve misafirler profil arama ve önizleme yapabilir
      allow read: if true;
      
      // Kullanıcı kendi profilini veya admin yeni profil oluşturabilir
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Kullanıcı kendi profil bilgilerini (durum, bio, avatar, son görülme),
      // veya admin tüm kullanıcı alanlarını (doğrulama, ban vb.) güncelleyebilir
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isEmailInReview', 'isBanned', 'role', 'isVerified'])
        )
      );

      
      // Hesap silme işlemi
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // 🪪 PUSH NOTIFICATION TOKENLARI (fcmTokens)
      match /fcmTokens/{tokenId} {
        // Yalnızca kullanıcı kendi tokenlarını okuyup yazabilir
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // 📖 KULLANICI BELLEĞİ (MEMORIES)
      match /memories/{memoryId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // 🎨 AI GÖRSEL ÜRETİM KOTASI (/users/{userId}/imageQuota/{quotaId})
      match /imageQuota/{quotaId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if false; // Yalnızca sunucu tarafı (Firebase Admin SDK) güncelleyebilir
      }

      // ✍️ MESAJ TASLAKLARI (/users/{userId}/drafts/{draftId})
      match /drafts/{draftId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner(userId));
      }

      // 🗂️ KULLANICININ TAKİP ETTİĞİ KANALLAR
      match /followingChannels/{channelId} {
        allow read, write: if isAuthenticated();
      }

      // 🗂️ KULLANICININ OLUŞTURDUĞU / KURUCU OLDUĞU KANALLAR
      match /myChannels/{channelId} {
        allow read, write: if isAuthenticated();
      }

      // 🔔 KULLANICININ KANAL BİLDİRİMLERİ (/users/{userId}/channelNotifications/{notifId})
      match /channelNotifications/{notifId} {
        allow read, write: if isAuthenticated();
      }

      // 🚫 KULLANICI ENGELLEME LİSTESİ (/users/{userId}/blockedUsers/{blockedUserId})
      match /blockedUsers/{blockedUserId} {
        // Yalnızca kullanıcı kendi engelleme kayıtlarını okuyabilir
        allow read: if isAuthenticated() && isOwner(userId);

        // Yalnızca kullanıcı kendi engelleme kaydını oluşturabilir (kendi listesine ekleme)
        allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.blockedUserId == blockedUserId;

        // Yalnızca kullanıcı kendi engelleme kaydını silebilir (engeli kaldırma)
        allow delete: if isAuthenticated() && isOwner(userId);

        // Güncelleme yapılamaz (kayıt silinip yeniden eklenir)
        allow update: if false;
      }
    }
    
    // =========================================================================
    // 🏷️ BENZERSİZ KULLANICI ADI REZERVASYONU (/usernames/{usernameLower})
    // =========================================================================
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 💬 SOHBETLER & GRUPLAR (/conversations/{conversationId})
    // =========================================================================
    match /conversations/{conversationId} {
      // Sohbet listesini dinleme (where participantIds contains) ve doğrudan sohbet getDoc sorgusu
      allow read: if isAuthenticated();
      
      // Yeni birebir sohbet, grup sohbeti veya RedChat AI sohbeti başlatma
      allow create: if isAuthenticated();
      
      // Son mesaj metni, son mesaj zamanı, okunmamış sayaçları (unreadCounts), grup üyeleri güncelleme
      // Sonlandırılmış (terminated) oturumun durumunu normal kullanıcılar tekrar aktife çekemez
      allow update: if isAuthenticated() && (
        resource.data.get('securityStatus', 'active') != 'terminated' ||
        request.resource.data.get('securityStatus', 'terminated') == 'terminated' ||
        isAdmin()
      );
      
      // Grubu silme veya sohbetten ayrılma
      allow delete: if isAuthenticated();
      
      // =======================================================================
      // 📨 SOHBET İÇİ MESAJLAR (/conversations/{conversationId}/messages/{messageId})
      // =======================================================================
      match /messages/{messageId} {
        // Sohbetteki tüm mesajları gerçek zamanlı dinleme ve okuma
        allow read: if isAuthenticated();
        
        // Yeni mesaj gönderme:
        // - Normal kullanıcı mesajları
        // - Sistem mesajları (gruba katıldı, ayrıldı, grup adı değişti vb.)
        // - RedChat AI tarafından üretilen yanıtlar (senderId: system_redchat_ai)
        // - Sonlandırılmış (terminated) sohbete normal kullanıcı mesaj yazamaz
        // - Engellenmiş birebir sohbetlere mesaj yazılamaz
        allow create: if isAuthenticated() && (!isEmailInReview() || isAdmin()) && (

          (
            // Grup sohbeti veya engeli olmayan birebir sohbet
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('isGroup', false) == true ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('blockedUserIds', []).size() == 0 ||
            isAdmin()
          ) &&
          (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('securityStatus', 'active') != 'terminated' ||
            request.resource.data.get('isSecurityWarning', false) == true ||
            isAdmin()
          )
        );
        
        // Mesaj düzenleme (isEdited: true) ve emoji reaksiyonları ekleme/kaldırma
        allow update: if isAuthenticated();
        
        // Mesaj silme işlemi (benden sil / herkesten sil)
        allow delete: if isAuthenticated();
      }
    }

    // =========================================================================
    // 🔍 COLLECTION GROUP MESAJ ERİŞİMİ
    // =========================================================================
    // Global mesaj sayacı, admin istatistikleri ve arama filtreleri
    match /{path=**}/messages/{messageId} {
      allow read: if isAuthenticated();
    }

    // =========================================================================
    // 📢 KANALLAR SİSTEMİ (/channels/{channelId})
    // =========================================================================
    
    // Kanal kurucu kontrolü yardımcısı (kurucu bilgisini gizli dokümandan okur)
    function isChannelOwner(channelId) {
      return isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/channels/$(channelId)/private/owner) &&
          get(/databases/$(database)/documents/channels/$(channelId)/private/owner).data.ownerId == request.auth.uid
        )
      );
    }

    match /channels/{channelId} {
      // Kanalları tüm oturum açmış kullanıcılar listeleyebilir ve okuyabilir
      allow read: if isAuthenticated();

      // Kanal oluşturma
      allow create: if isAuthenticated();

      // Güncelleme: Kurucu veya Admin her şeyi güncelleyebilir; normal kullanıcılar takipçi sayısını artırıp azaltabilir
      allow update: if isAuthenticated();

      // Kanalı silme işlemi
      allow delete: if isAuthenticated();

      // 🔐 KURUCU GİZLİLİĞİ DOKÜMANI (/channels/{channelId}/private/owner)
      match /private/owner {
        allow read, write: if isAuthenticated();
      }

      // 👥 TAKİPÇİLER (/channels/{channelId}/followers/{followerUid})
      match /followers/{followerUid} {
        allow read, write: if isAuthenticated();
      }

      // 📝 GÖNDERİLER (/channels/{channelId}/posts/{postId})
      match /posts/{postId} {
        allow read: if isAuthenticated();
        // Create is blocked if the user is muted
        allow create: if isAuthenticated() && !isUserMuted();
        // Update/Delete are allowed for authenticated users (owner/admin logic applied in UI)
        allow update, delete: if isAuthenticated();

        // 👁️ BENZERSİZ GÖRÜNTÜLENME KAYITLARI (/channels/{channelId}/posts/{postId}/views/{viewerUid})
        match /views/{viewerUid} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // =========================================================================
    // 🌍 YENİ ÜLKE & OTURUM GÜVENLİĞİ (/securitySessions, /securitySessionNetwork)
    // =========================================================================
    match /securitySessions/{sessionId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.status in ['active', 'pending_verification'] &&
        request.resource.data.trusted == (request.resource.data.status == 'active') &&
        request.resource.data.adminDecision in ['pending', 'auto_trusted'] &&
        (
          request.resource.data.status == 'pending_verification' ||
          !exists(/databases/$(database)/documents/userSecurityProfiles/$(request.auth.uid)) ||
          request.resource.data.countryCode in get(/databases/$(database)/documents/userSecurityProfiles/$(request.auth.uid)).data.knownCountryCodes ||
          request.resource.data.deviceId in get(/databases/$(database)/documents/userSecurityProfiles/$(request.auth.uid)).data.knownDeviceIds
        )
      );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        (
          // 1. Aktif oturum son görülme kalp atışı
          (
            resource.data.status == 'active' &&
            request.resource.data.status == 'active' &&
            request.resource.data.trusted == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
          ) ||
          // 2. Kullanıcı "Bu Benim" dedi (oturum kilidi açılmaz, admin onayı bekler)
          (
            resource.data.status == 'pending_verification' &&
            request.resource.data.status == 'awaiting_admin_approval' &&
            request.resource.data.userResponse == 'confirmed_me' &&
            request.resource.data.trusted == false &&
            request.resource.data.adminDecision == 'pending'
          ) ||
          // 3. Kullanıcı "Ben Değilim" dedi veya kendi oturumunu iptal etti
          (
            resource.data.status != 'revoked' &&
            request.resource.data.status == 'revoked' &&
            request.resource.data.trusted == false &&
            request.resource.data.adminDecision == 'revoked'
          )
        )
      );

      allow delete: if isAdmin();
    }

    // IP adresleri & ağ metadatası YALNIZCA yetkili adminlere açıktır (PII izolasyonu)
    match /securitySessionNetwork/{sessionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.sessionId == sessionId
      );
      allow update, delete: if isAdmin();
    }

    match /userSecurityProfiles/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == userId
      );
      // Normal kullanıcı kendi bilinen ülke listesini istemciden genişletemez
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.knownCountryCodes == resource.data.knownCountryCodes
      );
      allow delete: if isAdmin();
    }

    // Değiştirilemez Admin & Güvenlik Denetim Logları
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.category == 'security_session'
      );
      allow update, delete: if false;
    }
  }
}
